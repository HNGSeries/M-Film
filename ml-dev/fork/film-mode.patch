+#ifndef _fos_jpeg_h_
+#define _fos_jpeg_h_
+
+#include <stdint.h>
+
+/* what goes into the JPEG's EXIF (any may be NULL) */
+struct fos_jpeg_meta
+{
+    const char *when;           /* "2026-10-22 17:45" */
+    const char *desc;           /* the film */
+    const char *fstop;          /* "2.8" */
+};
