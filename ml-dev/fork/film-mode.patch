+        case SCR_SHELF: shelf_key(k); break;
+        case SCR_HOME:  home_key(k);  break;
+        case SCR_PAGE:  page_key(k);  break;
+        case SCR_ROLL:  roll_key(k);  break;
+        case SCR_DARK:  dark_key(k);  break;
